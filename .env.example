# Real-Time Demand & Risk Intelligence Engine Configuration
# Copy this file to .env and adjust variables as appropriate for your environment.

# Environment & Logging
DEMAND_RISK_ENVIRONMENT=development
DEMAND_RISK_LOG_LEVEL=INFO

# Security & Authentication
# In production, set DEMAND_RISK_AUTH_ENABLED=true and define a strong DEMAND_RISK_API_KEY
DEMAND_RISK_AUTH_ENABLED=false
DEMAND_RISK_API_KEY=dr-prod-secret-key-42
DEMAND_RISK_ALLOWED_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501", "http://localhost:3000"]

# Database Connection (SQLite local / PostgreSQL staging)
DEMAND_RISK_DATABASE_URL=sqlite:///./demand_risk_engine.db

# Random Seed for Deterministic Simulation
DEMAND_RISK_RANDOM_SEED=42

# Planning & Replenishment Defaults
DEMAND_RISK_DEFAULT_SERVICE_LEVEL=0.95
DEMAND_RISK_DEFAULT_LEAD_TIME_DAYS=7
DEMAND_RISK_FORECAST_HORIZON_DAYS=14
